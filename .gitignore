# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
*.egg-info/

# Secrets and local configuration (never commit)
.env
.env.*
*.pem
*.key
credentials*.json
my.cnf
.my.cnf

# Local database files (e.g. a MySQL data directory used for testing)
mysql_data/
*.sock
*.pid
*.log

# OS / editors
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp

# Power BI temporary / cache files (the .pbix itself SHOULD be committed)
*.pbix.bak
~$*
.pbi/localSettings.json
.pbi/cache.abf
